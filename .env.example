# Ubuntu Seeds — Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's already in .gitignore)

# ── EmailJS Configuration ────────────────────────────────────────────────────
# Get these from https://www.emailjs.com/
# Step 1: Create a free account
# Step 2: Add Email Service (Gmail/Outlook) → copy Service ID
# Step 3: Create Email Template → copy Template ID
# Step 4: Account > API Keys → copy Public Key

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_contact_xxxxxxx
VITE_EMAILJS_DEALER_TEMPLATE_ID=template_dealer_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx

# ── EmailJS Template Variables ───────────────────────────────────────────────
# Use these variable names in your EmailJS templates:
#   {{from_name}}   - Sender's name
#   {{from_phone}}  - Sender's mobile number
#   {{from_email}}  - Sender's email (set as Reply-To)
#   {{subject}}     - Message subject
#   {{message}}     - Message body
#   {{to_name}}     - "Ubuntu Seeds" (auto-filled)
